{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "emtech-ai-api",
  "main": "src/index.js",
  "compatibility_date": "2025-06-01",

  // Qwen endpoint (Singapore workspace — not a secret, safe in config).
  // Lives here so every `wrangler deploy` carries it (§38: model/endpoint
  // configurable without touching the frontend).
  "vars": {
    // Emergency switch (§38): set to "false" + redeploy to shut down model
    // calls without touching the website (health → "disabled", /api/ai → 503).
    "AI_ENABLED": "true",

    "QWEN_BASE_URL": "https://ws-lum9z1oqbnbg6tu2.ap-southeast-1.maas.aliyuncs.com/compatible-mode/v1",

    // CORS allow-list (§27): the public site + local dev server only.
    "ALLOWED_ORIGINS": "https://emtechbytes-cpu.github.io,http://localhost:8123,http://127.0.0.1:8123"
  }

  // Optional: global rate-limit store (see README → "Rate limiting").
  // Create it with `npx wrangler kv namespace create RATE_LIMITS`, then
  // uncomment and fill in the id. Without it, a per-isolate in-memory
  // limiter is used automatically — deploy works either way.
  //
  // "kv_namespaces": [{ "binding": "RATE_LIMITS", "id": "<namespace-id>" }]
}
